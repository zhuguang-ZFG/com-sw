/* COM-SW Dark Theme Stylesheet */

QMainWindow {
    background-color: #2B2B2B;
    color: #D4D4D4;
}

QMenuBar {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border-bottom: 1px solid #555;
}

QMenuBar::item:selected {
    background-color: #505050;
}

QMenu {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #555;
}

QMenu::item:selected {
    background-color: #0078D4;
}

QToolBar {
    background-color: #333333;
    border-bottom: 1px solid #555;
    padding: 2px;
}

QStatusBar {
    background-color: #333333;
    color: #888;
    border-top: 1px solid #555;
}

QTabWidget::pane {
    border: none;
    background-color: #2B2B2B;
}

QTabBar::tab {
    background-color: #333;
    color: #CCC;
    padding: 6px 16px;
    border: 1px solid #555;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #2B2B2B;
    color: #FFF;
}

QTabBar::tab:hover {
    background-color: #444;
}

QGroupBox {
    color: #CCC;
    border: 1px solid #555;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    background-color: #3C3C3C;
    color: #D4D4D4;
    border: 1px solid #555;
    padding: 4px 12px;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #505050;
}

QPushButton:pressed {
    background-color: #606060;
}

QComboBox {
    background-color: #3C3C3C;
    color: #D4D4D4;
    border: 1px solid #555;
    padding: 2px 8px;
    border-radius: 3px;
}

QComboBox:hover {
    border-color: #0078D4;
}

QComboBox QAbstractItemView {
    background-color: #3C3C3C;
    color: #D4D4D4;
    selection-background-color: #0078D4;
}

QComboBox::drop-down {
    border: none;
}

QLineEdit {
    background-color: #3C3C3C;
    color: #D4D4D4;
    border: 1px solid #555;
    padding: 4px;
    border-radius: 3px;
}

QSpinBox {
    background-color: #3C3C3C;
    color: #D4D4D4;
    border: 1px solid #555;
    padding: 2px;
    border-radius: 3px;
}

QCheckBox {
    color: #CCC;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QLabel {
    color: #CCC;
}

QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCC;
    padding: 4px;
    border: 1px solid #3C3C3C;
}

QScrollBar:vertical {
    background-color: #2B2B2B;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #555;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QDockWidget {
    color: #CCC;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #333;
    padding: 4px;
    border: 1px solid #555;
}
